rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil e dados privados: cada usuário acessa somente o próprio UID.
    match /users/{userId} {
      allow read, create, update: if request.auth != null
        && request.auth.uid == userId;

      match /treatments/{treatmentId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /doseHistory/{historyId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /notificationSchedules/{scheduleId} {
        allow read, create, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // Catálogo clínico: usuários podem consultar, mas não alterar.
    match /medications/{medicationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /interactionRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bloqueia qualquer coleção não prevista.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
